# Where the built client looks for SpacetimeDB. Vite bakes this into the bundle,
# so `npm run deploy` has to run again after changing it.
#
# Committed on purpose: it is the address every player's browser connects to,
# not a secret, and having it in the repo is what makes the deployed client
# reproducible from a fresh clone. Point it at your own service if you fork.
VITE_STDB_URI=https://neon-bay-production.up.railway.app

# Only needed if the module was published under a different name.
# VITE_STDB_DB=physics-sidecar
