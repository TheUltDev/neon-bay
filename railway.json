{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "physics/**",
      "sidecar/**",
      "module/**",
      "scripts/railway-start.sh"
    ]
  },
  "deploy": {
    "healthcheckPath": "/v1/ping",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "us-east4-eqdc4a": { "numReplicas": 1 }
    }
  }
}
